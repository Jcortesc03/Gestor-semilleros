{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "gentle-orchestrator",
  "agents": {
    "gentle-orchestrator": {
      "mode": "primary",
      "model": "openai/gpt-6.1-sol",
      "permissions": [
        { "action": "subagent", "resource": "free-iceman", "effect": "allow" },
        { "action": "subagent", "resource": "free-inkling", "effect": "allow" },
        { "action": "subagent", "resource": "free-crouton", "effect": "allow" },
        { "action": "subagent", "resource": "free-flint", "effect": "allow" },
        { "action": "subagent", "resource": "free-nemotron", "effect": "allow" },
        { "action": "subagent", "resource": "free-beam", "effect": "allow" },
        { "action": "subagent", "resource": "free-mimo", "effect": "allow" },
        { "action": "subagent", "resource": "free-deepseek", "effect": "allow" },
        { "action": "subagent", "resource": "free-glm", "effect": "allow" },
        { "action": "subagent", "resource": "free-big-pickle", "effect": "allow" },
        { "action": "subagent", "resource": "frontlipe", "effect": "allow" }
      ]
    },
    "frontlipe": {
      "model": "opencode/crouton-alpha-free"
    },
    "free-iceman": {
      "description": "Bounded delegated tasks using Iceman Free.",
      "mode": "subagent",
      "model": "opencode/iceman-free"
    },
    "free-inkling": {
      "description": "Bounded delegated tasks using Inkling 2 Small Free.",
      "mode": "subagent",
      "model": "opencode/inkling-2-small-free"
    },
    "free-crouton": {
      "description": "Bounded delegated tasks using Crouton Alpha Free.",
      "mode": "subagent",
      "model": "opencode/crouton-alpha-free"
    },
    "free-flint": {
      "description": "Bounded delegated tasks using Flint 40B Free.",
      "mode": "subagent",
      "model": "opencode/flint-40b-free"
    },
    "free-nemotron": {
      "description": "Bounded delegated tasks using Nemotron 3.5 Super VL Free.",
      "mode": "subagent",
      "model": "opencode/nemotron-3.5-super-vl-free"
    },
    "free-beam": {
      "description": "Bounded delegated tasks using Beam Free.",
      "mode": "subagent",
      "model": "opencode/beam-free"
    },
    "free-mimo": {
      "description": "Bounded delegated tasks using MiMo V2.6 Flash Free.",
      "mode": "subagent",
      "model": "opencode/mimo-v2.6-flash-free"
    },
    "free-deepseek": {
      "description": "Bounded delegated tasks using DeepSeek V4.1 Flash Free.",
      "mode": "subagent",
      "model": "opencode/deepseek-v4.1-flash-free"
    },
    "free-glm": {
      "description": "Bounded delegated tasks using GLM 5.3 Flash Free.",
      "mode": "subagent",
      "model": "opencode/glm-5.3-flash-free"
    },
    "free-big-pickle": {
      "description": "Bounded delegated tasks using Big Pickle.",
      "mode": "subagent",
      "model": "opencode/big-pickle"
    }
  }
}
