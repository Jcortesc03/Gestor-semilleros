# Variables del despliegue con contenedores (docker/compose.prod.yaml, ADR 0012).
# Copia este archivo a docker/.env.prod (ignorado por git) y completa los valores.
# Nunca versiones docker/.env.prod: contiene secretos.

# ─── Publicación ───────────────────────────────────────────────────────
# Puerto del host donde se publica la aplicación (web + /api).
WEB_PORT=8080
# Etiqueta de las imágenes construidas.
IMAGE_TAG=latest

# ─── PostgreSQL (contenedor interno, sin puerto publicado) ─────────────
POSTGRES_USER=semilleros
# [OBLIGATORIA] Usa una contraseña larga y aleatoria: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=semilleros

# ─── Backend ───────────────────────────────────────────────────────────
# DATABASE_URL, PORT, NODE_ENV y AUTH_TRUST_HOST los fija compose.prod.yaml.
# El resto de variables son las de apps/backend/.env.example (mismo significado).

# [OBLIGATORIA] Mínimo 32 caracteres: openssl rand -base64 32
AUTH_SECRET=
AUTH_SESSION_MAX_AGE=28800

# Google (opcional; definir las dos juntas). URI de redirección a registrar:
#   https://TU-DOMINIO/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Copias de notificaciones: smtp | log | disabled  y  builderbot | log | disabled
NOTIFICATIONS_EMAIL_TRANSPORT=log
NOTIFICATIONS_WHATSAPP_TRANSPORT=log
NOTIFICATIONS_AUTO_DISPATCH=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
WHATSAPP_PROVIDER=baileys
WHATSAPP_SESSION_NAME=whatsapp
WHATSAPP_PAIRING_PHONE=

# Microsoft Teams (opcional). URI de redirección: https://TU-DOMINIO/api/integrations/microsoft/callback
MICROSOFT_TENANT_ID=common
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=
MICROSOFT_TOKEN_ENCRYPTION_KEY=
MICROSOFT_LINK_REDIRECT_URL=
MEETINGS_TIME_ZONE=America/Bogota

# Documentos en AWS S3 (ADR 0013). Sin bucket o credenciales, los endpoints de documentos responden 503.
# Deja S3_ENDPOINT vacío para usar AWS; no actives S3_CREATE_BUCKET en producción.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_CREATE_BUCKET=false
#
# Para PROBAR el despliegue sin AWS, con RustFS (perfil s3-local de compose.prod.yaml):
#   S3_BUCKET=semilleros-documentos
#   S3_ENDPOINT=http://s3:9000
#   S3_ACCESS_KEY_ID=<un usuario>        (RustFS lo toma como usuario administrador)
#   S3_SECRET_ACCESS_KEY=<una clave larga>
#   S3_FORCE_PATH_STYLE=true
#   S3_CREATE_BUCKET=true
#   S3_CONSOLE_PORT=9001   (consola de RustFS en 127.0.0.1; cámbialo si 9001 está ocupado, p. ej. por pnpm db:up)
# y levanta con:  docker compose -f docker/compose.prod.yaml --env-file docker/.env.prod --profile s3-local up -d --build
