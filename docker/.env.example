# ═══════════════════════════════════════════════════════════════════════
#  Variables del contenedor de PostgreSQL local (docker/compose.yaml)
# ═══════════════════════════════════════════════════════════════════════
#
#  Este archivo es OPCIONAL: docker/compose.yaml ya usa estos mismos valores
#  por defecto. Cópialo solo si necesitas cambiarlos:
#      cp docker/.env.example docker/.env
#
#  ⚠️ Si cambias cualquiera, actualiza también DATABASE_URL y
#     TEST_DATABASE_URL en apps/backend/.env.
#  ⚠️ Usuario, contraseña y base solo se aplican al CREAR el volumen. Si el
#     contenedor ya existía, tendrás que recrearlo, lo que BORRA los datos
#     locales:  docker compose -f docker/compose.yaml down -v
# ═══════════════════════════════════════════════════════════════════════

# Usuario administrador de PostgreSQL dentro del contenedor.
POSTGRES_USER=semilleros

# Contraseña de ese usuario. Solo para desarrollo local; no la reutilices.
POSTGRES_PASSWORD=semilleros

# Base de datos que se crea al iniciar por primera vez (la de desarrollo).
# La de pruebas (semilleros_test) la crean las pruebas e2e automáticamente.
POSTGRES_DB=semilleros

# Puerto del equipo en el que se publica PostgreSQL (el interno siempre es 5432).
# Cámbialo si ya tienes otro PostgreSQL usando el 5432.
POSTGRES_PORT=5432

# ─── Almacenamiento S3 local (RustFS, ADR 0013) ─────────────────────────
# Credenciales del servidor S3 local. Si las cambias, actualiza S3_ACCESS_KEY_ID
# y S3_SECRET_ACCESS_KEY en apps/backend/.env.
S3_ACCESS_KEY=semilleros
S3_SECRET_KEY=semilleros-local
# Puertos del host: API S3 y consola web.
S3_PORT=9000
S3_CONSOLE_PORT=9001
