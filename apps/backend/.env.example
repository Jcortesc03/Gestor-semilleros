# Copia este archivo a .env (no se versiona).
# Los valores coinciden con los predeterminados de docker/compose.yaml
# y solo son válidos para desarrollo local.
DATABASE_URL="postgresql://semilleros:semilleros@localhost:5432/semilleros?schema=public"

# Puerto HTTP del backend.
PORT=3000

# ── Auth.js ──────────────────────────────────────────────────
# Secreto para firmar/cifrar las sesiones (mínimo 32 caracteres).
# Genera uno con: openssl rand -base64 32
AUTH_SECRET=""
# true en desarrollo local o detrás de un proxy de confianza.
AUTH_TRUST_HOST=true
# Duración de la sesión en segundos (por defecto 8 horas).
AUTH_SESSION_MAX_AGE=28800

# Google OAuth (opcional). Si se omiten, solo se habilita correo + contraseña.
# URI de redirección a registrar en Google Cloud:
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Base de datos usada por las pruebas e2e (se borra en cada ejecución).
TEST_DATABASE_URL="postgresql://semilleros:semilleros@localhost:5432/semilleros_test?schema=public"
