# ═══════════════════════════════════════════════════════════════════════
#  Variables de entorno del backend (apps/backend)
# ═══════════════════════════════════════════════════════════════════════
#
#  Uso:   cp apps/backend/.env.example apps/backend/.env
#         y completa los valores marcados como [OBLIGATORIA].
#
#  - El archivo .env NUNCA se versiona (está en .gitignore).
#  - Los valores de ejemplo solo sirven para desarrollo local.
#  - El backend valida estas variables al arrancar (src/config/env.ts) y
#    se detiene con un mensaje claro si falta alguna obligatoria.
#  - Las variables ya definidas en el sistema tienen prioridad sobre .env.
# ═══════════════════════════════════════════════════════════════════════


# ─── Base de datos ─────────────────────────────────────────────────────

# [OBLIGATORIA] Cadena de conexión a PostgreSQL que usan Prisma y el backend.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?schema=public
# Este valor coincide con el contenedor de docker/compose.yaml (pnpm db:up).
# Si cambias docker/.env (usuario, contraseña o puerto), actualízala aquí.
DATABASE_URL="postgresql://semilleros:semilleros@localhost:5432/semilleros?schema=public"


# ─── Servidor HTTP ─────────────────────────────────────────────────────

# [Opcional · por defecto 3000] Puerto en el que escucha el backend.
# La API queda en http://localhost:PORT/api
PORT=3000


# ─── Autenticación (Auth.js) ───────────────────────────────────────────

# [OBLIGATORIA] Secreto con el que Auth.js firma y cifra las cookies de sesión.
# - Mínimo 32 caracteres; usa un valor aleatorio distinto en cada entorno.
# - Si cambia, todas las sesiones abiertas dejan de ser válidas.
# - Genéralo con:  openssl rand -base64 32
AUTH_SECRET=""

# [Opcional · por defecto false] Si es true, Auth.js confía en el encabezado
# Host de la petición para construir sus URLs (redirecciones, callbacks).
# - true en desarrollo local o detrás de un proxy inverso de confianza.
# - false si el backend está expuesto directamente y no controlas el Host.
AUTH_TRUST_HOST=true

# [Opcional · por defecto 28800 = 8 horas] Duración máxima de una sesión,
# en segundos. Al vencer, el usuario debe volver a iniciar sesión.
AUTH_SESSION_MAX_AGE=28800


# ─── Inicio de sesión con Google (opcional) ────────────────────────────
#
# Si ambas quedan vacías, solo se habilita "correo + contraseña".
# Deben definirse JUNTAS; si solo hay una, el backend no arranca.
#
# Cómo obtenerlas: Google Cloud Console → APIs y servicios → Credenciales →
# "ID de cliente de OAuth" (tipo Aplicación web). Registra como URI de
# redirección autorizada:
#     http://localhost:3000/api/auth/callback/google
# (cambia host y puerto según el entorno).
#
# Solo pueden entrar usuarios ya registrados, con el correo verificado por Google.

# ID de cliente OAuth (termina en .apps.googleusercontent.com).
AUTH_GOOGLE_ID=""
# Secreto de cliente OAuth. Trátalo como una contraseña.
AUTH_GOOGLE_SECRET=""


# ─── Pruebas e2e ───────────────────────────────────────────────────────

# [Opcional] Base de datos de las pruebas de la API (pnpm test:e2e).
# - ⚠️ Se VACÍA en cada prueba: nunca la apuntes a datos reales.
# - Su nombre DEBE terminar en "_test"; si no, las pruebas se niegan a correr.
# - Se crea y migra automáticamente. Por defecto: semilleros_test en el mismo
#   contenedor de PostgreSQL.
TEST_DATABASE_URL="postgresql://semilleros:semilleros@localhost:5432/semilleros_test?schema=public"


# ─── Datos de desarrollo (seed) ────────────────────────────────────────

# [Obligatoria solo para pnpm db:seed] Contraseña común de los usuarios de
# demostración que crea la seed (admin@, encargado.area@, decano@, tutor@,
# lider@ y estudiante@example.test). Entre 8 y 256 caracteres.
# La seed no se ejecuta con NODE_ENV=production.
# Es preferible pasarla al ejecutar el comando en lugar de guardarla aquí:
#     SEED_PASSWORD='…' pnpm db:seed
SEED_PASSWORD=""


# ─── Crear un administrador (admin:create) ─────────────────────────────
#
# El script pnpm --filter @gestor-semilleros/backend admin:create lee estas
# variables. NO las guardes aquí; pásalas al ejecutar el comando para que la
# contraseña no quede en un archivo:
#     ADMIN_EMAIL=admin@example.test ADMIN_FULL_NAME="Administrador" \
#       ADMIN_PASSWORD='…' pnpm --filter @gestor-semilleros/backend admin:create
#
# ADMIN_EMAIL=        correo del administrador (único).
# ADMIN_FULL_NAME=    nombre completo.
# ADMIN_PASSWORD=     contraseña inicial (8–256 caracteres).
