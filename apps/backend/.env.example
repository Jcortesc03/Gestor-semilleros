# ═══════════════════════════════════════════════════════════════════════
#  Variables de entorno del backend (apps/backend)
# ═══════════════════════════════════════════════════════════════════════
#
#  Uso:   cp apps/backend/.env.example apps/backend/.env
#         y completa los valores marcados como [OBLIGATORIA].
#
#  - El archivo .env NUNCA se versiona (está en .gitignore).
#  - Los valores de ejemplo solo sirven para desarrollo local.
#  - El backend valida estas variables al arrancar (src/config/env.ts) y
#    se detiene con un mensaje claro si falta alguna obligatoria.
#  - Las variables ya definidas en el sistema tienen prioridad sobre .env.
# ═══════════════════════════════════════════════════════════════════════


# ─── Base de datos ─────────────────────────────────────────────────────

# [OBLIGATORIA] Cadena de conexión a PostgreSQL que usan Prisma y el backend.
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?schema=public
# Este valor coincide con el contenedor de docker/compose.yaml (pnpm db:up).
# Si cambias docker/.env (usuario, contraseña o puerto), actualízala aquí.
DATABASE_URL="postgresql://semilleros:semilleros@localhost:5432/semilleros?schema=public"


# ─── Servidor HTTP ─────────────────────────────────────────────────────

# [Opcional · por defecto 3000] Puerto en el que escucha el backend.
# La API queda en http://localhost:PORT/api
PORT=3000


# ─── Autenticación (Auth.js) ───────────────────────────────────────────

# [OBLIGATORIA] Secreto con el que Auth.js firma y cifra las cookies de sesión.
# - Mínimo 32 caracteres; usa un valor aleatorio distinto en cada entorno.
# - Si cambia, todas las sesiones abiertas dejan de ser válidas.
# - Genéralo con:  openssl rand -base64 32
AUTH_SECRET=""

# [Opcional · por defecto false] Si es true, Auth.js confía en el encabezado
# Host de la petición para construir sus URLs (redirecciones, callbacks).
# - true en desarrollo local o detrás de un proxy inverso de confianza.
# - false si el backend está expuesto directamente y no controlas el Host.
AUTH_TRUST_HOST=true

# [Opcional · por defecto 28800 = 8 horas] Duración máxima de una sesión,
# en segundos. Al vencer, el usuario debe volver a iniciar sesión.
AUTH_SESSION_MAX_AGE=28800


# ─── Inicio de sesión con Google (opcional) ────────────────────────────
#
# Si ambas quedan vacías, solo se habilita "correo + contraseña".
# Deben definirse JUNTAS; si solo hay una, el backend no arranca.
#
# Cómo obtenerlas: Google Cloud Console → APIs y servicios → Credenciales →
# "ID de cliente de OAuth" (tipo Aplicación web). Registra como URI de
# redirección autorizada:
#     http://localhost:3000/api/auth/callback/google
# (cambia host y puerto según el entorno).
#
# Solo pueden entrar usuarios ya registrados, con el correo verificado por Google.

# ID de cliente OAuth (termina en .apps.googleusercontent.com).
AUTH_GOOGLE_ID=""
# Secreto de cliente OAuth. Trátalo como una contraseña.
AUTH_GOOGLE_SECRET=""


# ─── Notificaciones: copias por correo y WhatsApp ──────────────────────
#
# Al publicar una novedad se envía una copia a cada destinatario según sus
# preferencias (GET/PUT /api/me/notification-preferences). Ver
# docs/api/notification-preferences.md, el ADR 0005 y, para WhatsApp, el ADR 0006.
#
# Transporte de cada canal:
#   log       → solo registra el envío en el log (dirección enmascarada). No
#               envía nada real. Es el valor por defecto.
#   disabled  → canal apagado: no se encolan copias por él.
#   smtp / builderbot → envío real (requiere las variables de su bloque).

# [Opcional · por defecto log] smtp | log | disabled
NOTIFICATIONS_EMAIL_TRANSPORT=log
# [Opcional · por defecto log] builderbot | log | disabled
NOTIFICATIONS_WHATSAPP_TRANSPORT=log

# [Opcional · por defecto true] Si es false, los envíos pendientes no se
# procesan en segundo plano (las pruebas e2e lo desactivan).
NOTIFICATIONS_AUTO_DISPATCH=true
# [Opcional · por defecto 60] Cada cuántos segundos se revisan los envíos
# pendientes y los reintentos. Entre 5 y 3600.
NOTIFICATIONS_DISPATCH_INTERVAL=60
# [Opcional · por defecto 5] Intentos máximos por envío ante errores
# transitorios (espera exponencial de 1 min a 1 h). Entre 1 y 20.
NOTIFICATIONS_MAX_ATTEMPTS=5
# [Opcional · por defecto 24] Horas máximas que una copia puede esperar a
# enviarse (p. ej. mientras WhatsApp está desconectado; esas esperas no
# gastan intentos). Pasado ese tiempo se descarta para no enviar avisos
# viejos. Entre 1 y 168.
NOTIFICATIONS_MAX_DEFER_HOURS=24

# ── Correo (solo con NOTIFICATIONS_EMAIL_TRANSPORT=smtp) ──
# Sirve cualquier servidor SMTP (Microsoft 365, Gmail, el de la universidad…).
# [Obligatoria con smtp] Servidor SMTP.
SMTP_HOST=""
# [Opcional · por defecto 587] Puerto (1–65535). 587 = STARTTLS, 465 = TLS.
SMTP_PORT=587
# [Opcional · por defecto false] true para TLS implícito (puerto 465).
SMTP_SECURE=false
# [Opcional] Credenciales: se definen las dos juntas o ninguna.
# SMTP_PASSWORD es un secreto: nunca lo versiones.
SMTP_USER=""
SMTP_PASSWORD=""
# [Obligatoria con smtp] Remitente, p. ej.: "Semilleros" <no-responder@example.test>
EMAIL_FROM=""

# ── WhatsApp (solo con NOTIFICATIONS_WHATSAPP_TRANSPORT=builderbot) ──
# WhatsApp mediante BuilderBot, con un provider intercambiable. Hoy solo está
# disponible Baileys, que usa WhatsApp Web (no oficial) y no necesita
# plantillas: se envía texto libre (asunto en negrita y cuerpo). Ver el
# ADR 0006 y docs/api/notification-preferences.md.
#
# Cómo vincular la cuenta:
#   1. Arranca el backend (pnpm dev).
#   2. Con una sesión de administrador, consulta el estado en
#      GET /api/integrations/whatsapp/status y el QR en
#      GET /api/integrations/whatsapp/qr.
#   3. Escanea el QR desde WhatsApp → Dispositivos vinculados. Si defines
#      WHATSAPP_PAIRING_PHONE, usa el código de emparejamiento del estado.
#
# ⚠️ Baileys usa WhatsApp Web, que no es la API oficial: conviene un número
# dedicado y existe riesgo de bloqueo si se hacen envíos masivos.
#
# [Opcional · por defecto baileys] Provider de BuilderBot.
WHATSAPP_PROVIDER=baileys
# [Opcional · por defecto whatsapp] Nombre de la sesión: de 1 a 40 caracteres,
# en minúsculas, dígitos, guiones y guiones bajos. Baileys guarda las
# credenciales en apps/backend/<nombre>_sessions/, que está ignorado por git:
# trátalo como un secreto y borra esa carpeta para desvincular la cuenta.
WHATSAPP_SESSION_NAME=whatsapp
# [Opcional] Número E.164 de la cuenta que se vincula (con «+», p. ej.
# +573000000001). Si se define, se usa un código de emparejamiento en lugar
# del QR (útil sin pantalla).
WHATSAPP_PAIRING_PHONE=""


# ─── Microsoft Teams (reuniones) ───────────────────────────────────────
#
# Cada usuario vincula su cuenta de Microsoft (laboral o educativa con Teams)
# en GET /api/integrations/microsoft/connect. Al crear una reunión, se agenda
# en su calendario de Microsoft con un enlace de Teams (cuenta laboral o
# educativa) o con el enlace que indique (cuenta personal).
#
# Cómo registrar la aplicación en Entra ID (portal.azure.com):
#   1. Entra ID → Registros de aplicaciones → Nuevo registro.
#   2. Tipo de cuenta: el que corresponda al inquilino (por ejemplo, «solo
#      cuentas de este directorio organizacional» o «cuentas de cualquier
#      directorio organizacional»). Se refleja en MICROSOFT_TENANT_ID.
#   3. URI de redirección (tipo Web) = el valor de MICROSOFT_REDIRECT_URI.
#   4. Certificados y secretos → Nuevo secreto de cliente: guarda el valor
#      en MICROSOFT_CLIENT_SECRET (solo se muestra una vez).
#   5. Permisos de API → Microsoft Graph → Permisos delegados:
#      offline_access, openid, profile, email, User.Read, Calendars.ReadWrite.
#      Concede el consentimiento de administrador si el inquilino lo exige.
#
# Si MICROSOFT_CLIENT_ID y MICROSOFT_CLIENT_SECRET quedan vacías, la
# integración se desactiva y la creación de reuniones responde 503.
# Deben definirse JUNTAS; si solo hay una, el backend no arranca.

# [Opcional · por defecto common] Inquilino de Entra ID. common admite cuentas
# laborales, educativas y personales (ADR 0014; con una cuenta personal el
# organizador indica el enlace de la reunión). Para restringir el acceso usa
# organizations (solo laborales o educativas), un GUID de inquilino o un
# dominio (p. ej. universidad.edu.co). Cualquier otro valor impide arrancar.
MICROSOFT_TENANT_ID=common
# [Obligatoria si la integración está activa] ID de aplicación (cliente) de
# Entra ID.
MICROSOFT_CLIENT_ID=""
# [Obligatoria si la integración está activa] Secreto de cliente. Trátalo
# como una contraseña: nunca lo versiones.
MICROSOFT_CLIENT_SECRET=""
# [Obligatoria si la integración está activa] URL http(s) a la que Microsoft
# devuelve el código OAuth. Debe coincidir con el URI de redirección Web
# registrado, por ejemplo:
#     http://localhost:3000/api/integrations/microsoft/callback
MICROSOFT_REDIRECT_URI=""
# [Obligatoria si la integración está activa] Clave AES-256 (32 bytes) en
# base64 con la que se cifran los tokens y el state de OAuth. Genérala con:
#     openssl rand -base64 32
MICROSOFT_TOKEN_ENCRYPTION_KEY=""
# [Opcional · por defecto respuesta JSON] URL http(s) adonde redirigir el
# navegador al terminar la vinculación (p. ej. la app web).
MICROSOFT_LINK_REDIRECT_URL=""
# [Opcional · por defecto America/Bogota] Zona horaria IANA con la que se
# muestran las fechas de las reuniones en los avisos.
MEETINGS_TIME_ZONE=America/Bogota


# ─── Documentos en S3 (ADR 0013) ───────────────────────────────────────
#
# Todo es opcional: si falta el bucket o las credenciales, el backend arranca
# igual y los endpoints de documentos responden 503. Los valores de abajo son
# los de desarrollo para RustFS (pnpm db:up, servicio "s3" de docker/compose.yaml).

# Nombre del bucket donde se guardan los documentos.
S3_BUCKET=semilleros-documentos
# [Opcional · por defecto us-east-1] Región del bucket.
S3_REGION=us-east-1
# [Opcional] Endpoint de un servidor compatible con S3. Déjalo vacío en AWS.
S3_ENDPOINT=http://localhost:9000
# Credenciales de acceso (en AWS, de un usuario IAM con permisos sobre el bucket).
S3_ACCESS_KEY_ID=semilleros
S3_SECRET_ACCESS_KEY=semilleros-local
# [Opcional · por defecto false] true con RustFS/MinIO (direcciones /bucket/clave).
S3_FORCE_PATH_STYLE=true
# [Opcional · por defecto false] Crea el bucket al arrancar si no existe. Solo desarrollo.
S3_CREATE_BUCKET=true


# ─── IA: recomendaciones con Claude (ADR 0018) ────────────────────────

# [Opcional] Clave de la API de Claude (https://platform.claude.com). Sin ella la
# IA queda desactivada (la web lo indica y POST /api/ai/recommendations responde 503).
# Nunca versiones la clave real.
ANTHROPIC_API_KEY=""
# [Opcionales] Modelo (por defecto claude-sonnet-5-5), esfuerzo de razonamiento
# (low, medium, high, xhigh, max; por defecto high), tokens de salida, tiempo por
# intento y reintentos del SDK. ANTHROPIC_REFUSAL_FALLBACK=false desactiva el
# reintento en el servidor cuando Claude rechaza una petición.
# ANTHROPIC_MODEL="claude-sonnet-5-5"
# ANTHROPIC_EFFORT="high"
# ANTHROPIC_MAX_TOKENS="16000"
# ANTHROPIC_TIMEOUT_MS="120000"
# ANTHROPIC_MAX_RETRIES="1"
# ANTHROPIC_REFUSAL_FALLBACK="true"
# ANTHROPIC_BASE_URL=""
# Caché de análisis idénticos en segundos (0 la desactiva) y límite por usuario y hora.
# AI_CACHE_TTL_SECONDS="600"
# AI_RATE_LIMIT_PER_HOUR="20"

# ─── Pruebas e2e ───────────────────────────────────────────────────────

# [Opcional] Base de datos de las pruebas de la API (pnpm test:e2e).
# - ⚠️ Se VACÍA en cada prueba: nunca la apuntes a datos reales.
# - Su nombre DEBE terminar en "_test"; si no, las pruebas se niegan a correr.
# - Se crea y migra automáticamente. Por defecto: semilleros_test en el mismo
#   contenedor de PostgreSQL.
TEST_DATABASE_URL="postgresql://semilleros:semilleros@localhost:5432/semilleros_test?schema=public"


# ─── Datos de desarrollo (seed) ────────────────────────────────────────

# [Obligatoria solo para pnpm db:seed] Contraseña común de los usuarios de
# demostración que crea la seed (admin@, encargado.area@, decano@, tutor@,
# lider@ y estudiante@example.test). Entre 8 y 256 caracteres.
# La seed no se ejecuta con NODE_ENV=production.
# Es preferible pasarla al ejecutar el comando en lugar de guardarla aquí:
#     SEED_PASSWORD='…' pnpm db:seed
SEED_PASSWORD=""

# [Opcionales, solo para pnpm db:seed:bulk] Seed masiva para la analítica
# (usa también SEED_PASSWORD). Escala del volumen, entero de 1 a 10 (por defecto 1),
# y SEED_BULK_RESET=1 para borrar solo los datos de una seed masiva anterior.
#     SEED_PASSWORD='…' SEED_BULK_SCALE=2 pnpm db:seed:bulk
SEED_BULK_SCALE=""
SEED_BULK_RESET=""


# ─── Crear un administrador (admin:create) ─────────────────────────────
#
# El script pnpm --filter @gestor-semilleros/backend admin:create lee estas
# variables. NO las guardes aquí; pásalas al ejecutar el comando para que la
# contraseña no quede en un archivo:
#     ADMIN_EMAIL=admin@example.test ADMIN_FULL_NAME="Administrador" \
#       ADMIN_PASSWORD='…' pnpm --filter @gestor-semilleros/backend admin:create
#
# ADMIN_EMAIL=        correo del administrador (único).
# ADMIN_FULL_NAME=    nombre completo.
# ADMIN_PASSWORD=     contraseña inicial (8–256 caracteres).
