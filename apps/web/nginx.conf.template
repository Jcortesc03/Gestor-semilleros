# Plantilla de nginx para la web (imagen nginx:1.29-alpine).
# La imagen oficial sustituye solo ${BACKEND_URL} con envsubst; las variables de nginx ($uri, $host...) se conservan.
# Web y API comparten origen: /api/ va al backend y el resto son archivos estáticos de la SPA.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 26m;  # 25 MB por documento (ADR 0013) + margen del multipart

    # Cabeceras de seguridad básicas. No se define CSP para no bloquear Google ni Montserrat local.
    # Por la herencia de add_header de nginx, se repiten en las ubicaciones que definen sus propias cabeceras.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    # Por defecto, las respuestas no se cachean (index.html y fallback de la SPA).
    add_header Cache-Control "no-cache" always;

    # API: se conserva la ruta completa (sin URI en proxy_pass, nginx reenvía la petición tal cual).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    # Archivos con hash de Vite: cache largo e inmutable. Un archivo inexistente responde 404, no index.html.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
    }

    # SPA: rutas como /login o /panel devuelven index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
