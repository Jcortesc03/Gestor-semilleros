# Plantilla de nginx para la web (imagen nginx:1.29-alpine).
# La imagen oficial sustituye con envsubst solo variables de entorno definidas (${BACKEND_URL}, ${NGINX_LOCAL_RESOLVERS});
# las variables de nginx ($uri, $host...) se conservan.
# Web y API comparten origen: /api/ va al backend y el resto son archivos estáticos de la SPA.

# Protocolo original de la petición. Detrás de un proxy que termina TLS (p. ej. el borde de Railway)
# nginx recibe HTTP, pero el usuario usa HTTPS: se respeta el X-Forwarded-Proto entrante para que
# Auth.js construya URLs https. Sin proxy delante (compose local) se usa el esquema propio.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    client_max_body_size 26m;  # 25 MB por documento (ADR 0013) + margen del multipart

    # Cabeceras de seguridad básicas. No se define CSP para no bloquear Google ni Montserrat local.
    # Por la herencia de add_header de nginx, se repiten en las ubicaciones que definen sus propias cabeceras.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Frame-Options DENY always;

    # Por defecto, las respuestas no se cachean (index.html y fallback de la SPA).
    add_header Cache-Control "no-cache" always;

    # DNS del contenedor (NGINX_LOCAL_RESOLVERS lo calcula la imagen a partir de /etc/resolv.conf).
    # Con proxy_pass por variable, nginx vuelve a resolver el nombre del backend cada 10 s en lugar de
    # fijar la IP al arrancar: si el backend se redespliega y cambia de IP (p. ej. la red privada de
    # Railway), la web no se queda enviando peticiones a una IP vieja.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=on;
    resolver_timeout 5s;

    # API: se conserva la ruta completa (proxy_pass por variable y sin URI reenvía la petición tal cual).
    location /api/ {
        set $backend_upstream "${BACKEND_URL}";
        proxy_pass $backend_upstream;
        # Si el backend no responde, fallar pronto (502/504) en lugar de dejar la web esperando un minuto.
        proxy_connect_timeout 10s;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    # IA (ADR 0018): el análisis con Claude puede superar los 60 s por defecto de nginx.
    # El backend corta antes (ANTHROPIC_TIMEOUT_MS por intento, 120 s y 1 reintento por defecto).
    location /api/ai/ {
        proxy_pass ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_read_timeout 320s;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header X-Forwarded-Host $http_host;
    }

    # Archivos con hash de Vite: cache largo e inmutable. Un archivo inexistente responde 404, no index.html.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header X-Frame-Options DENY always;
    }

    # SPA: rutas como /login o /panel devuelven index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
