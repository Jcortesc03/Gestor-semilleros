{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "inputs": [
        "prisma/schema.prisma",
        "prisma.config.ts"
      ],
      "outputs": [
        "src/generated/**"
      ],
      "passThroughEnv": [
        "DATABASE_URL"
      ]
    },
    "lint": {
      "dependsOn": [
        "db:generate"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "eslint.config.*",
        "eslint-suppressions.json",
        "tsconfig*.json"
      ]
    },
    "lint:fix": {
      "dependsOn": [
        "db:generate"
      ],
      "cache": false
    },
    "test": {},
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ]
    },
    "clean": {
      "cache": false
    },
    "test:e2e": {
      "cache": false
    }
  }
}
